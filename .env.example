# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required in production. Generate a random value of at least 32 characters.
SESSION_SECRET=

# First company manager, used only when no non-demo operator exists.
BOOTSTRAP_OPERATOR_NAME=
BOOTSTRAP_OPERATOR_PIN=

# Never enable demo operators or sample orders in a company production deployment.
ALLOW_DEMO_OPERATORS=false
ALLOW_DEMO_DATA=false

# Microsoft Graph (Outlook), optional.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=operations@yourcompany.example
